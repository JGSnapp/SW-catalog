SERVER_URL=http://agent_server:8000
PORT=8000
DATA_DIR=/data

# OpenAI-compatible runtime for Agents SDK
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=gpt-4.1-mini

# Optional compatibility with existing proxy envs
PROXY_MODEL=gpt-4.1-mini
PROXY_API_KEY=
PROXY_BASE_URL=

# Tools
JINA_READER_BASE_URL=https://r.jina.ai/
DIRECT_READER_ENABLED=true
PLAYWRIGHT_READER_ENABLED=true
XMLSTOCK_GOOGLE_URL=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
