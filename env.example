SERVER_URL=http://agent_server:8000
PORT=8000
DATA_DIR=/data

# ----- Postgres / аккаунты -----
POSTGRES_DB=stroky
POSTGRES_USER=stroky
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stroky:change-me@postgres:5432/stroky
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=8080

# ----- LLM-провайдер -----
# OpenRouter через ProxyAPI. Endpoint совместим с OpenAI Chat Completions:
# https://api.proxyapi.ru/openrouter/v1/chat/completions
PROXY_API_KEY=
PROXY_BASE_URL=https://api.proxyapi.ru/openrouter/v1
PROXY_MODEL=qwen/qwen3-235b-a22b-2507
PROXY_FALLBACK_MODEL=openai/gpt-oss-120b

# Если хочется напрямую в OpenAI — раскомментируйте и заполните:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AGENT_MODEL=gpt-4.1-mini

# ----- Reader chain (чтение страниц поставщиков) -----
JINA_READER_BASE_URL=https://r.jina.ai/
DIRECT_READER_ENABLED=true
PLAYWRIGHT_READER_ENABLED=true
READER_TIMEOUT_SECONDS=20
PLAYWRIGHT_BROWSER_WORKERS=1

# ----- Background worker limits -----
SUPPLIER_WORKERS=1
IMAGE_SEARCH_WORKERS=1
UPLOAD_PARSE_WORKERS=1
MAX_DISCOVERY_ITERATIONS=5
MAX_MONITOR_ITERATIONS=3

# ----- Web search (XMLStock / XMLSearch совместимый) -----
# Нужен для агента discovery (поиск новых поставщиков). Без него кнопка
# «Найти поставщиков» в карточке позиции будет падать.
XMLSTOCK_GOOGLE_URL=
XML_SEARCH_TIMEOUT_SECONDS=15
XML_SEARCH_RETRIES=3
XML_SEARCH_MIN_WAIT_SECONDS=2
XML_SEARCH_MAX_WAIT_SECONDS=4

# ----- Image search (XMLStock Yandex Live) -----
# Нужен для поиска картинки к позиции. Без него кнопка «Найти картинку»
# будет падать.
XMLSTOCK_YANDEXLIVE_URL=
IMAGE_SEARCH_TIMEOUT_SECONDS=15
IMAGE_SEARCH_RETRIES=3
IMAGE_SEARCH_WAIT_SECONDS=1.5
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
